// ============================================================
// SCHEMA — Buku Dapur (v3: Cleanup tabel tidak dipakai webf UI)
// Revisi 08 Okt 2026: Hapus tabel data_pelanggan, data_pemasok,
// hutang, jenis_akun — tidak ada UI di webf yang menggunakannya.
// Hapus field order/hutang/pemasok/pelanggan dari Transaksi.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ArahTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum TipeDataKolom {
  TEKS
  ANGKA
  TANGGAL
  DROPDOWN
}

enum SumberInput {
  MANUAL
  AI
}

enum AksiLog {
  TAMBAH
  UBAH
  HAPUS
}

model Pengguna {
  id           Int      @id @default(autoincrement())
  nama         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  dibuatPada   DateTime @default(now()) @map("dibuat_pada") @db.DateTime(0)

  transaksi       Transaksi[]
  logAudit        LogAudit[]
  jenisTransaksi  JenisTransaksi[]
  kolomCustom     KolomCustom[]
  tabelBebas      TabelBebas[]
  cmsContent      CmsContent[]
  cmsMenu         CmsMenu[]

  @@map("pengguna")
}

/// Master Transaksi — daftar jenis transaksi, full CRUD oleh user.
model JenisTransaksi {
  id              Int            @id @default(autoincrement())
  kode            String         @unique @db.VarChar(10)
  namaTransaksi   String         @map("nama_transaksi") @db.VarChar(150)
  arah            ArahTransaksi
  jenisAkun       String?        @map("jenis_akun") @db.VarChar(150)
  unitBisnis      String?        @map("unit_bisnis") @db.VarChar(50)
  isBawaan        Boolean        @default(false) @map("is_bawaan")
  aktif           Boolean        @default(true)
  dibuatOleh      Int?           @map("dibuat_oleh")
  dibuatPada      DateTime       @default(now()) @map("dibuat_pada") @db.DateTime(0)

  pengguna        Pengguna?      @relation(fields: [dibuatOleh], references: [id])
  kolomCustom     KolomCustom[]
  transaksi       Transaksi[]

  @@map("jenis_transaksi")
}

/// Kolom tambahan bebas per JenisTransaksi
model KolomCustom {
  id               Int            @id @default(autoincrement())
  jenisTransaksiId Int            @map("jenis_transaksi_id")
  namaKolom        String         @map("nama_kolom") @db.VarChar(100)
  tipeData         TipeDataKolom  @map("tipe_data")
  opsiDropdown     Json?          @map("opsi_dropdown")
  urutan           Int            @default(0)
  aktif            Boolean        @default(true)
  dibuatOleh       Int?           @map("dibuat_oleh")
  dibuatPada       DateTime       @default(now()) @map("dibuat_pada") @db.DateTime(0)

  jenisTransaksi   JenisTransaksi @relation(fields: [jenisTransaksiId], references: [id])
  pengguna         Pengguna?      @relation(fields: [dibuatOleh], references: [id])

  @@map("kolom_custom")
  @@index([jenisTransaksiId])
}

model Produk {
  id            Int      @id @default(autoincrement())
  kode          String   @unique @db.VarChar(20)
  namaBarang    String   @map("nama_barang") @db.VarChar(100)
  varian        String?  @db.VarChar(100)
  satuan        String   @default("pcs") @db.VarChar(20)
  hargaDefault  Decimal  @default(0) @map("harga_default") @db.Decimal(15, 2)
  gambar        String?  @db.Text
  deskripsi      String?  @db.Text
  aktif         Boolean  @default(true)
  dibuatPada    DateTime @default(now()) @map("dibuat_pada") @db.DateTime(0)

  @@map("produk")
}

/// Entri Transaksi — TABEL INTI. Satu baris = satu entri di bawah satu
/// JenisTransaksi. Kolom wajib: tanggal, detail, jenisKas, nominal.
model Transaksi {
  id               Int             @id @default(autoincrement())
  kode             String          @unique @db.VarChar(30)
  tanggal          DateTime        @db.Date
  unitBisnis       String?         @map("unit_bisnis") @db.VarChar(50)

  jenisTransaksiId Int             @map("jenis_transaksi_id")
  namaTransaksi    String          @map("nama_transaksi") @db.VarChar(150)

  detail           String?         @db.VarChar(255)
  jenisKas         String?         @map("jenis_kas") @db.VarChar(50)
  nominal          Decimal         @db.Decimal(15, 2)

  debit            String?         @db.VarChar(150)
  kredit           String?         @db.VarChar(150)

  customData       Json?           @map("custom_data")

  sumberInput      SumberInput     @default(MANUAL) @map("sumber_input")
  dibuatOleh       Int             @map("dibuat_oleh")
  dibuatPada       DateTime        @default(now()) @map("dibuat_pada") @db.DateTime(0)
  diubahPada       DateTime        @updatedAt @map("diubah_pada") @db.DateTime(0)

  jenisTransaksi   JenisTransaksi  @relation(fields: [jenisTransaksiId], references: [id])
  pengguna         Pengguna        @relation(fields: [dibuatOleh], references: [id])

  @@map("transaksi")
  @@index([tanggal])
  @@index([jenisTransaksiId])
  @@index([unitBisnis])
}

/// Fitur "Buat Tabel Bebas" — TERPISAH TOTAL dari Master Transaksi.
model TabelBebas {
  id           Int                @id @default(autoincrement())
  namaTabel    String             @unique @map("nama_tabel") @db.VarChar(100)
  deskripsi    String?            @db.VarChar(255)
  dibuatOleh   Int                @map("dibuat_oleh")
  dibuatPada   DateTime           @default(now()) @map("dibuat_pada") @db.DateTime(0)

  kolom        KolomTabelBebas[]
  baris        BarisTabelBebas[]
  pengguna     Pengguna           @relation(fields: [dibuatOleh], references: [id])

  @@map("tabel_bebas")
}

model KolomTabelBebas {
  id            Int            @id @default(autoincrement())
  tabelBebasId  Int            @map("tabel_bebas_id")
  namaKolom     String         @map("nama_kolom") @db.VarChar(100)
  tipeData      TipeDataKolom  @map("tipe_data")
  opsiDropdown  Json?          @map("opsi_dropdown")
  urutan        Int            @default(0)

  tabelBebas    TabelBebas @relation(fields: [tabelBebasId], references: [id], onDelete: Cascade)

  @@map("kolom_tabel_bebas")
  @@index([tabelBebasId])
}

model BarisTabelBebas {
  id            Int        @id @default(autoincrement())
  tabelBebasId  Int        @map("tabel_bebas_id")
  data          Json
  dibuatPada    DateTime   @default(now()) @map("dibuat_pada") @db.DateTime(0)
  diubahPada    DateTime   @updatedAt @map("diubah_pada") @db.DateTime(0)

  tabelBebas    TabelBebas @relation(fields: [tabelBebasId], references: [id], onDelete: Cascade)

  @@map("baris_tabel_bebas")
  @@index([tabelBebasId])
}

/// Riwayat / audit log
model LogAudit {
  id             Int      @id @default(autoincrement())
  penggunaId     Int      @map("pengguna_id")
  tabelTarget    String   @map("tabel_target") @db.VarChar(50)
  targetId       Int?     @map("target_id")
  aksi           AksiLog
  sumber         SumberInput
  command        String?  @db.VarChar(50)
  labelRecord    String   @map("label_record") @db.VarChar(150)
  detail         String?  @db.VarChar(255)
  dataSebelum    String?  @map("data_sebelum") @db.Text
  dataSesudah    String?  @map("data_sesudah") @db.Text
  dibuatPada     DateTime @default(now()) @map("dibuat_pada") @db.DateTime(0)

  pengguna       Pengguna @relation(fields: [penggunaId], references: [id])

  @@map("log_audit")
  @@index([tabelTarget])
  @@index([sumber])
  @@index([dibuatPada])
}

/// CMS Content - konten yang bisa dikustomisasi untuk customer page
model CmsContent {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(100)
  judul        String   @db.VarChar(255)
  subJudul     String?  @map("sub_judul") @db.Text
  konten       String?  @db.Text
  aktif        Boolean  @default(true)
  dibuatOleh   Int      @map("dibuat_oleh")
  dibuatPada   DateTime @default(now()) @map("dibuat_pada") @db.DateTime(0)
  diubahPada   DateTime @updatedAt @map("diubah_pada") @db.DateTime(0)

  pengguna     Pengguna @relation(fields: [dibuatOleh], references: [id])

  @@map("cms_content")
}

/// CMS Menu - menu navigasi untuk customer page
model CmsMenu {
  id           Int      @id @default(autoincrement())
  label        String   @db.VarChar(100)
  path         String   @db.VarChar(100)
  urutan       Int      @default(0)
  aktif        Boolean  @default(true)
  dibuatOleh   Int      @map("dibuat_oleh")
  dibuatPada   DateTime @default(now()) @map("dibuat_pada") @db.DateTime(0)
  diubahPada   DateTime @updatedAt @map("diubah_pada") @db.DateTime(0)

  pengguna     Pengguna @relation(fields: [dibuatOleh], references: [id])

  @@map("cms_menu")
  @@index([urutan])
}
